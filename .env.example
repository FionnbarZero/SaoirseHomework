# Safe-test is the default. Change this only after completing GOOGLE_SETUP.md.
HOMEWORK_GOOGLE_MODE=safe-test

# Create an OAuth client whose application type is "Desktop app".
HOMEWORK_GOOGLE_CLIENT_ID=

# Google Desktop clients may include this value. Leave it empty when the
# downloaded client configuration does not contain one.
HOMEWORK_GOOGLE_CLIENT_SECRET=

# Read-only daily schedule import. The account value belongs in the untracked
# local .env file; do not commit a child’s email address here.
HOMEWORK_CALENDAR_ACCOUNT_EMAIL=child@example.com
HOMEWORK_CALENDAR_ID=primary

# Permanent Cloud Run hosting. Firestore stores an encrypted-in-transit,
# compressed snapshot of the SQLite database after every completed API request.
# Secret Manager stores the Google Calendar refresh token.
GOOGLE_CLOUD_PROJECT=
HOMEWORK_PERSISTENCE=local
HOMEWORK_FIRESTORE_DOCUMENT=homework_state/saoirse
HOMEWORK_CALENDAR_TOKEN_SECRET=

# Existing Google Doc used by the Writing screen. Newest attempts are written first.
HOMEWORK_WRITING_LOG_DOCUMENT_ID=
HOMEWORK_WRITING_LOG_TAB_ID=t.0

# Optional two-pass AI detection and verification. Both values are required before a
# parent can enable Shadow, Parent review, or Guided practice mode. The API key
# stays in the local service and is never sent to the browser. Choose a current
# text model in the OpenAI dashboard/docs; the app intentionally has no silent
# model default.
OPENAI_API_KEY=
HOMEWORK_OPENAI_MODEL=

# Optional. The default is America/Los_Angeles.
HOMEWORK_TIME_ZONE=America/Los_Angeles

# Required before Parent controls can unlock. Generate a unique value with
# `openssl rand -base64 32` and copy the same value into the untracked guardian
# configuration. Never commit the generated value.
HOMEWORK_GUARDIAN_SHARED_SECRET=

# Preview keeps recovery locking off while developing. Enforcing locks the
# child UI during Homework mode if the guardian, managed Chrome, or service fails.
HOMEWORK_SECURITY_MODE=preview

# Cloud hosting stays opt-in; never expose an instance in local mode.
# These are server-side settings, not VITE_ browser variables. Private-cloud
# startup fails unless all four Access settings are complete. Parent controls
# still require their separate authorization; Access login does not grant them.
HOMEWORK_DEPLOYMENT_MODE=local
HOMEWORK_PUBLIC_ORIGIN=
HOMEWORK_ACCESS_TEAM_ORIGIN=
HOMEWORK_ACCESS_AUDIENCE=
HOMEWORK_ACCESS_EMAILS=
