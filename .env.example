# Safe-test is the default. Change this only after completing GOOGLE_SETUP.md.
HOMEWORK_GOOGLE_MODE=safe-test

# Create an OAuth client whose application type is "Desktop app".
HOMEWORK_GOOGLE_CLIENT_ID=

# Google Desktop clients may include this value. Leave it empty when the
# downloaded client configuration does not contain one.
HOMEWORK_GOOGLE_CLIENT_SECRET=

# Optional. The default is America/Los_Angeles.
HOMEWORK_TIME_ZONE=America/Los_Angeles
