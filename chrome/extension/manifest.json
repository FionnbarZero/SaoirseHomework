{
  "manifest_version": 3,
  "name": "Fionnbar Homework Guardian",
  "short_name": "Homework",
  "description": "Keeps managed Chrome on the approved learning path during Homework mode.",
  "version": "0.1.0",
  "minimum_chrome_version": "120",
  "key": "",
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://youtube.com/*", "https://*.youtube.com/*"],
      "js": ["youtube-playback.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Homework Guardian",
    "default_popup": "popup.html"
  },
  "incognito": "not_allowed",
  "permissions": [
    "alarms",
    "declarativeNetRequest",
    "storage",
    "tabs",
    "webNavigation"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "web_accessible_resources": [
    {
      "resources": ["blocked.html", "blocked.css", "blocked.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
