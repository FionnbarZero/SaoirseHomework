{
  "name": "fionnbar-homework-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "dev:server": "node server/index.mjs",
    "start": "node server/index.mjs",
    "test": "node --test tests/domain.test.ts tests/database.test.mjs tests/chrome-extension.test.mjs",
    "build": "tsc -b && vite build",
    "build:chrome": "node scripts/build-chrome-extension.mjs",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "typescript": "latest"
  }
}
